# Next.js public site. Copy to .env.local for local work; never commit it.
# Server-only values (no NEXT_PUBLIC_ prefix) never reach the browser.
# For local builds, set every variable in the process too (handover 2.4): a value left unset falls back to .env.local.

# Absolute origin of this site, used for canonical, hreflang and sitemaps.
SITE_URL=http://127.0.0.1:3000

# Core (Laravel) API origin, read by the Next server.
CORE_API_URL=http://127.0.0.1:8000

# Server key the Next server sends to the core API. Real value only in .env.local and in hPanel, never here.
CORE_API_KEY=

NEXT_TELEMETRY_DISABLED=1
