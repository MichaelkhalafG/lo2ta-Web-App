# Core (Laravel) environment. Copy to .env and fill locally; never commit .env.
# APP_NAME is the Latin site name (mail sender, dashboard title in English). The Arabic name lives in the locale config.
# Secrets (APP_KEY, DB password, mail password, API keys) live only in .env on each machine or server.

APP_NAME=Lokta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Arabic first. The URL decides the language on the public site; this is the core's default.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MariaDB 11.8 (port 3307 on the dev machine). Scratch database only, never production.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=lo2ta_scratch
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Shared hosting: no worker, no Redis.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local default writes mail to the log. Real SMTP values go in the server .env only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Public site origin (Next.js), used for links in e-mails and CORS.
FRONTEND_URL=http://127.0.0.1:3000

VITE_APP_NAME="${APP_NAME}"
